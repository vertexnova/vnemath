<mxfile host="app.diagrams.net">
    <diagram name="Typical usage" id="api">
        <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="600" math="0" shadow="0" background="#1C1C1E">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <mxCell id="step1" value="1. Include" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E1A07;strokeColor=#E8622A;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#EBEBF0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="60" width="140" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="inc" value="#include &lt;vertexnova/math/math.h&gt;&#10;using namespace vne::math;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C2C2E;strokeColor=#48484A;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#EBEBF0;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="320" height="70" as="geometry"/>
                </mxCell>

                <mxCell id="step2" value="2. Transforms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E1A07;strokeColor=#E8622A;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#EBEBF0;" parent="1" vertex="1">
                    <mxGeometry x="500" y="60" width="160" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="use" value="Mat4f M = modelMatrix(pos, rot, scale);&#10;Mat4f V = Mat4f::lookAt(eye, center, up, api);&#10;Mat4f P = Mat4f::perspective(fovy, aspect, n, f, api);&#10;Mat4f mvp = mvp(M, V, P);" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C2C2E;strokeColor=#48484A;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#EBEBF0;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="420" y="120" width="420" height="110" as="geometry"/>
                </mxCell>

                <mxCell id="step3" value="3. Optional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E1A07;strokeColor=#E8622A;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#EBEBF0;" parent="1" vertex="1">
                    <mxGeometry x="980" y="60" width="140" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="opt" value="project(world, mvp, viewport, api);&#10;intersect(ray, aabb);&#10;GpuMat4f for UBO packing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C2C2E;strokeColor=#48484A;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#EBEBF0;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="920" y="120" width="320" height="90" as="geometry"/>
                </mxCell>

                <mxCell id="arr1" style="endArrow=blockThin;endFill=1;html=1;strokeWidth=2;strokeColor=#E8622A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="inc" target="use" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arr2" style="endArrow=blockThin;endFill=1;html=1;strokeWidth=2;strokeColor=#E8622A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="use" target="opt" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
